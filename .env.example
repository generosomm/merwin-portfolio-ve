# =============================================================
# Environment variables for the live social stats backend (/api).
#
# This file is a TEMPLATE: names and comments only, never values.
# Real values go in Vercel > Project > Settings > Environment
# Variables. To run locally, `vercel env pull .env.local` copies
# them into .env.local, which .gitignore keeps out of Git.
#
# Step-by-step instructions for every value: docs/SOCIAL-API-SETUP.md
# =============================================================


# ---- Security ------------------------------------------------
# A long random string you make up. It protects the one-time
# "connect my account" routes (/api/auth/*/start), manual refresh
# and /api/health. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=

# Another long random string (generate it the same way, but make it
# different from ADMIN_SECRET). Vercel sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" when the daily cron calls
# /api/refresh, so nobody else can trigger a refresh.
CRON_SECRET=

# Optional. Comma-separated origins allowed to read /api/stats from
# another site (CORS). The portfolio itself is same-origin and does
# not need this. Default if empty:
#   https://generosomm.dev,https://www.generosomm.dev
SITE_ORIGINS=


# ---- TikTok (developers.tiktok.com) --------------------------
# Manage apps > your app > Sandbox > App details > Client key / secret.
# Use the SANDBOX credentials (see the TikTok section of the guide
# for why this app can't go through production review).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match a Redirect URI registered under Login Kit, character
# for character.
TIKTOK_REDIRECT_URI=https://generosomm.dev/api/auth/tiktok/callback


# ---- YouTube (console.cloud.google.com) ----------------------
# APIs & Services > Credentials > API key, restricted to
# "YouTube Data API v3". Reads public data only; no OAuth needed.
YOUTUBE_API_KEY=
# Starts with "UC". YouTube Studio > Settings > Channel >
# Advanced settings, or youtube.com/account_advanced.
YOUTUBE_CHANNEL_ID=


# ---- Instagram (developers.facebook.com) ---------------------
# NOTE: these are NOT the Meta app ID/secret. Instagram Login has
# its own pair: App Dashboard > Instagram > API setup with Instagram
# login > 3. Set up Instagram business login > Business login settings.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must match a redirect URI saved in Business login settings.
INSTAGRAM_REDIRECT_URI=https://generosomm.dev/api/auth/instagram/callback


# ---- Facebook Page (developers.facebook.com) -----------------
# Only needed if facebook.com/eroedtx is a Facebook PAGE. Personal
# profiles (including professional mode) have no insights API.
# App Dashboard > App settings > Basic > App ID / App secret.
META_APP_ID=
META_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://generosomm.dev/api/auth/facebook/callback
# Leave EMPTY if you don't have a Page: the Facebook provider then
# reports status "disabled" and never calls Meta.
FACEBOOK_PAGE_ID=


# ---- Storage: Upstash Redis (via Vercel Marketplace) ---------
# Added automatically when you connect the Upstash database to the
# project; you don't type these. Depending on how the database was
# created, Vercel adds one of these pairs. The code reads either.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# ...or:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
